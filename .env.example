# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# localhost is a secure context as far as WebAuthn is concerned, so desktop
# passkeys work without HTTPS. The cross-device (phone/QR) flow is much less
# reliable here -- use the deployed origin to rehearse that part.
NEXT_PUBLIC_RP_NAME="Passkey Demo"
NEXT_PUBLIC_RP_ID=localhost
SESSION_SECRET=change-me-in-production

# Optional. Derived from NEXT_PUBLIC_RP_ID when omitted, which is what you want
# almost always. Set it only to accept more than one origin (comma-separated).
# A missing scheme is filled in for you.
# NEXT_PUBLIC_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Deployed (set these in the Vercel project settings)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_RP_ID=passkey.karanpatel.ca
#
# Pin RP_ID to the FULL hostname, not karanpatel.ca. A registrable-suffix RP ID
# would let the passkey work on every subdomain -- including the look-alike one
# used for the phishing demo, which would defeat the whole point.

# ---------------------------------------------------------------------------
# Storage (optional locally, strongly recommended when deployed)
# ---------------------------------------------------------------------------
# Without these the app writes to a JSON file. On a serverless host that file
# lives in /tmp on one instance, so a cold start mid-demo can lose the passkey
# you just registered. Add Upstash Redis from the Vercel marketplace and these
# variables get injected automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
